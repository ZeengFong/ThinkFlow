# Copy to frontend/.env.local and fill in. Never commit the real file.

# Where the backend runs (your Render URL in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase: project home page → "Copy" menu, or Project Settings → API Keys.
# Leave both empty for local mode (no sign-in).
NEXT_PUBLIC_SUPABASE_URL=
# The "Publishable key" (starts with sb_publishable_); safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Google "Web client" ID (…apps.googleusercontent.com), the same one set in
# Supabase → Authentication → Providers → Google. When set, the login page uses Google's
# own button, so Google's sign-in screen names this site instead of <project>.supabase.co.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
