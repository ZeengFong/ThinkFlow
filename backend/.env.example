# Copy to backend/.env and fill in. Never commit the real .env.

# ── AI (free) ──
# Groq (primary): https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (automatic fallback, optional): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional extras:
# OPENAI_API_KEY=            # paid OpenAI, used after the free providers
# OLLAMA_BASE_URL=http://localhost:11434   # fully local models via Ollama
# AI_PROVIDERS=groq,gemini,openai,ollama   # order to try them in
# GROQ_MODEL= / GEMINI_MODEL= / OPENAI_MODEL= / OLLAMA_MODEL=   # pin a model
# AI requests per student per day (0 = unlimited); protects the shared free key
AI_DAILY_LIMIT=60

# ── Sign-in (Supabase) ── leave empty for local mode (no sign-in, one local user)
SUPABASE_URL=
# Only for older Supabase projects that still use the legacy JWT secret:
# SUPABASE_JWT_SECRET=

# ── Deployment ──
# DATABASE_URL=postgresql://...      # default: local SQLite file (backend/thinkflow.db)
# FRONTEND_ORIGIN=https://your-app.vercel.app   # default: http://localhost:3000
